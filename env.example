# ==========================================
# VALORANT Scout - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values

# -----------------------------------------
# GRID Esports API
# -----------------------------------------
# Get your API key from: https://grid.gg/developer
GRID_API_KEY=your_grid_api_key_here
GRID_API_URL=https://api-op.grid.gg/central-data/graphql

# -----------------------------------------
# LLM Provider Configuration
# -----------------------------------------
# Choose your provider: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Anthropic (Claude) - Recommended
# Get your key from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (GPT-4) - Alternative
# Get your key from: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Model to use (defaults based on provider)
# Anthropic: claude-3-5-sonnet-20241022
# OpenAI: gpt-4-turbo-preview
LLM_MODEL=claude-3-5-sonnet-20241022

# -----------------------------------------
# Application Settings
# -----------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# Production: comma-separated frontend URLs the API will allow (no trailing slash)
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------
# Frontend (only when hosting frontend separately from backend)
# -----------------------------------------
# Set in your frontend host (Vercel/Netlify) so the app calls your backend URL:
# VITE_API_URL=https://your-backend.railway.app/api

# -----------------------------------------
# Redis (Optional - for caching)
# -----------------------------------------
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600
